# Bumpa staging (test data only)
BUMPA_BASE_URL=https://api.bumpa.xyz/api/commerce/v1
BUMPA_PUBLIC_KEY=pk_test_xxx
BUMPA_SECRET_KEY=sk_test_xxx
BUMPA_LOCATION_ID=your_location_id
# Fulfillment for checkouts: set ONE. Pickup needs a pickup location id; delivery needs a shipping method id.
BUMPA_PICKUP_LOCATION_ID=
BUMPA_SHIPPING_METHOD_ID=
# Shared secret Chord sends as "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=generate-a-long-random-string
# Optional: where flagged-order alerts are posted
ALERT_WEBHOOK_URL=
# Postgres connection string (Render: set automatically from the database via render.yaml)
DATABASE_URL=postgresql://user:password@localhost:5432/ogabassey
# Local dev only: skip bearer auth. Leave unset in production (server refuses /mcp without MCP_AUTH_TOKEN).
ALLOW_NO_AUTH=
